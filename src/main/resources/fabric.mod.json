{
  "schemaVersion": 1,
  "id": "deepresonance",
  "version": "${version}",
  "name": "DeepResonance",
  "description": "Power generation based on resonating crystals.",
  "authors": [
    "Elec332",
    "McJty"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "mcjty.deepresonance.DeepResonance"
    ],
    "client": [
      "mcjty.deepresonance.setup.ClientSetup"
    ],
    "fabric-datagen": [
      "mcjty.deepresonance.datagen.FabricDataGen"
    ],
    "jei_mod_plugin": [
      "mcjty.deepresonance.compat.jei.DeepResonanceJeiPlugin"
    ],
    "rftoolscontrol-opcodes": [
