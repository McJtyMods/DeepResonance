    ]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": ">=0.155.2+26.2",
    "forgeconfigapiport": ">=26.2.1",
    "mcjtylib": ">=26.2-10.0.3-fabric",
    "rftoolsbase": ">=26.2-8.0.0-fabric"
  },
  "suggests": {
    "theoneprobe": "*",
    "jei": "*",
    "rftoolscontrol": "*"
  },
  "accessWidener": "deepresonance.accesswidener",
  "mixins": [
    "deepresonance.mixins.json"
  ]
